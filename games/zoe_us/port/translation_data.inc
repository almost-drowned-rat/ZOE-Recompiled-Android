    {0x6029e03ef6efb13aull, {"I've more or less seen what happened\non the monitor.", "J'ai &`a peu pr&`es vu ce qui s'est pass&'e\nsur l'&'ecran.", "Ich habe die Lage so weit\nam Monitor verfolgt.", "Ho pi&`u o meno visto la situazione\nsul monitor.", "M&'as o menos he visto\nla situaci&'on por el monitor."}},  // fa2c1304#1
    {0x604180029667a638ull, {"After you get to Mars, I mean.", "Une fois sur Mars, je veux dire.", "Wenn du auf dem Mars bist, meine ich.", "Dopo essere arrivata su Marte, dico.", "Despu&'es de llegar a Marte, digo."}},  // edgr7361#21
    {0x6042c58a484534abull, {"and head for the spaceport via the transport\nelevator at the far end of the colony block.", "et rejoindrons le spatioport par l'ascenseur\nde transport &`a l'autre bout du bloc.", "und fahren mit dem Transportaufzug am anderen\nEnde des Kolonieblocks zum Raumhafen.", "e andremo allo spazioporto con l'ascensore\nmerci in fondo al blocco della colonia.", "y desde el ascensor de transporte del otro\nextremo del bloque de la colonia\niremos al puerto espacial."}},  // gl1r2371#10
    {0x60480632667b793eull, {"They're the same machines, and we still\nhave to fight?", "C'est la m&^eme machine, et il faut\nquand m&^eme se battre ?", "Es sind dieselben Maschinen, und\ntrotzdem m&~ussen wir k&~ampfen?", "Sono macchine uguali, e dobbiamo\ncomunque combattere?", "&~?Hay que luchar aunque sean\nm&'aquinas iguales?"}},  // tb1c4541#3
    {0x605ccc80323d87aeull, {"When I turned 10, it was decided Dad would\ngo to Jupiter, and for the first time in ages\nthe three of us went out to eat.", "&`A mes 10 ans, papa devait partir pour Jupiter,\net pour une fois, on est all&'es manger\ntous les trois.", "Als ich 10 wurde, stand fest, dass Papa zum\nJupiter geht, und wir gingen nach langer\nZeit mal wieder zu dritt essen.", "Quando ho compiuto 10 anni, pap&`a doveva\nandare su Giove, e dopo tanto tempo\nsiamo andati a cena tutti e tre.", "Cuando cumpl&'i 10 a&~nos, destinaron a pap&'a\na J&'upiter, y por primera vez en mucho\ntiempo fuimos a cenar los tres."}},  // sh1r7061#26
    {0x607498868f92ab0bull, {"Thank you.", "Merci.", "Danke.", "Grazie.", "Gracias."}},  // cb1a9a01#1
